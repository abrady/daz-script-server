// Shared DazScript runtime injected by DazScriptServer before every script.
//
// This is the lowest reusable layer for DAZ invariants that file-backed jobs
// and typed dazpy callers must share. Keep story and application policy out.
var DSS = (function () {
    function properties(node, label) {
        var result = [];
        var holders = [node];
        if (node && node.getObject && node.getObject()) holders.push(node.getObject());
        for (var h = 0; h < holders.length; h++) {
            var holder = holders[h];
            if (!holder || typeof holder.getNumProperties !== "function") continue;
            for (var p = 0; p < holder.getNumProperties(); p++) {
                var prop = holder.getProperty(p);
                if (prop && String(prop.getLabel()) === label) result.push(prop);
            }
        }
        return result;
    }

    function readChannel(node, label, getter) {
        var props = properties(node, label);
        var value = null;
        if (props.length) {
            value = !!props[0].getValue();
            for (var i = 1; i < props.length; i++) {
                if (!!props[i].getValue() !== value) {
                    throw new Error("Visibility properties disagree on '" +
                                    String(node.getLabel()) + "': " + label);
                }
            }
        } else if (getter && typeof node[getter] === "function") {
            value = !!node[getter]();
        }
        return { value: value, propertyCount: props.length };
    }

    function readVisibility(node) {
        if (!node) throw new Error("DSS.visibility.read: no node");
        var general = readChannel(node, "Visible", "isVisible");
        var viewport = readChannel(node, "Visible in Viewport", "isVisibleInViewport");
        var render = readChannel(node, "Visible in Render", "isVisibleInRender");
        var simulation = readChannel(node, "Visible in Simulation", null);
        return {
            general: general.value,
            viewport: viewport.value,
            render: render.value,
            simulation: simulation.value,
            propertyCounts: {
                general: general.propertyCount,
                viewport: viewport.propertyCount,
                render: render.propertyCount,
                simulation: simulation.propertyCount
            }
        };
    }

    function setChannel(node, spec, key, label, setter) {
        var wanted = spec[key];
        if (wanted === undefined || wanted === null) return;
        var props = properties(node, label);
        var hasSetter = setter && typeof node[setter] === "function";
        if (!props.length && !hasSetter) {
            throw new Error("Visibility channel not supported on '" +
                            String(node.getLabel()) + "': " + label);
        }
        if (hasSetter) node[setter](!!wanted);
        for (var i = 0; i < props.length; i++) props[i].setValue(wanted ? 1 : 0);
    }

    function setVisibility(node, spec) {
        if (!node) throw new Error("DSS.visibility.set: no node");
        spec = spec || {};
        setChannel(node, spec, "general", "Visible", "setVisible");
        setChannel(node, spec, "viewport", "Visible in Viewport", "setVisibleInViewport");
        setChannel(node, spec, "render", "Visible in Render", "setVisibleInRender");
        setChannel(node, spec, "simulation", "Visible in Simulation", null);
        Scene.update();

        var actual = readVisibility(node);
        var keys = ["general", "viewport", "render", "simulation"];
        for (var i = 0; i < keys.length; i++) {
            var key = keys[i];
            if (spec[key] !== undefined && spec[key] !== null &&
                actual[key] !== !!spec[key]) {
                throw new Error("Visibility channel would not retain value on '" +
                                String(node.getLabel()) + "': " + key);
            }
        }
        return actual;
    }

    function normalizeNodeQuery(query) {
        if (typeof query === "string") query = { either: query };
        query = query || {};
        var keys = ["label", "name", "either"];
        var selected = "";
        for (var i = 0; i < keys.length; i++) {
            if (!query.hasOwnProperty(keys[i]) ||
                query[keys[i]] === undefined || query[keys[i]] === null) continue;
            if (selected) {
                throw new Error("DSS.nodes: query must specify exactly one of label, name, or either");
            }
            selected = keys[i];
        }
        if (!selected || String(query[selected]).length === 0) {
            throw new Error("DSS.nodes: query must specify a non-empty label, name, or either");
        }
        return { by: selected, value: String(query[selected]) };
    }

    function describeNode(node) {
        if (!node) return null;
        var path = [];
        var cursor = node;
        var guard = 0;
        while (cursor && guard < 64) {
            path.unshift(String(cursor.getLabel ? cursor.getLabel() : cursor.getName()));
            cursor = cursor.getNodeParent ? cursor.getNodeParent() : null;
            guard++;
        }
        return {
            name: String(node.getName()),
            label: String(node.getLabel()),
            className: node.className ? String(node.className()) : "DzNode",
            path: path.join(" / ")
        };
    }

    function nodeMatchesNormalized(query) {
        var result = [];
        for (var i = 0; i < Scene.getNumNodes(); i++) {
            var node = Scene.getNode(i);
            if (!node) continue;
            var label = String(node.getLabel());
            var name = String(node.getName());
            if ((query.by === "label" && label === query.value) ||
                (query.by === "name" && name === query.value) ||
                (query.by === "either" && (label === query.value || name === query.value))) {
                result.push(node);
            }
        }
        return result;
    }

    function editDistance(left, right) {
        left = String(left).toLowerCase();
        right = String(right).toLowerCase();
        var previous = [];
        var current = [];
        for (var j = 0; j <= right.length; j++) previous[j] = j;
        for (var i = 1; i <= left.length; i++) {
            current = [i];
            for (var k = 1; k <= right.length; k++) {
                var replace = previous[k - 1] + (left.charAt(i - 1) === right.charAt(k - 1) ? 0 : 1);
                current[k] = Math.min(previous[k] + 1, current[k - 1] + 1, replace);
            }
            previous = current;
        }
        return previous[right.length];
    }

    function nearbyNodes(query, limit) {
        var ranked = [];
        for (var i = 0; i < Scene.getNumNodes(); i++) {
            var node = Scene.getNode(i);
            if (!node) continue;
            var description = describeNode(node);
            var values = query.by === "label" ? [description.label] :
                         query.by === "name" ? [description.name] :
                         [description.label, description.name];
            var score = editDistance(query.value, values[0]);
            for (var v = 1; v < values.length; v++) {
                score = Math.min(score, editDistance(query.value, values[v]));
            }
            ranked.push({ score: score, node: description });
        }
        ranked.sort(function (a, b) { return a.score - b.score; });
        var result = [];
        for (var r = 0; r < ranked.length && r < limit; r++) result.push(ranked[r].node);
        return result;
    }

    function formatNode(node) {
        return "label='" + node.label + "', name='" + node.name +
               "', class='" + node.className + "', path='" + node.path + "'";
    }

    function inspectNodes(query) {
        var normalized = normalizeNodeQuery(query);
        var matches = nodeMatchesNormalized(normalized);
        var descriptions = [];
        for (var i = 0; i < matches.length; i++) descriptions.push(describeNode(matches[i]));
        return {
            query: normalized,
            sceneNodeCount: Scene.getNumNodes(),
            matchCount: descriptions.length,
            matches: descriptions,
            nearby: descriptions.length ? [] : nearbyNodes(normalized, 5)
        };
    }

    function findNode(query) {
        var normalized = normalizeNodeQuery(query);
        var matches = nodeMatchesNormalized(normalized);
        if (!matches.length) return null;
        if (matches.length > 1) {
            var descriptions = [];
            for (var i = 0; i < matches.length; i++) descriptions.push(formatNode(describeNode(matches[i])));
            throw new Error("DSS.nodes.find: ambiguous " + normalized.by + " '" +
                            normalized.value + "' matched " + matches.length +
                            " nodes: " + descriptions.join("; "));
        }
        return matches[0];
    }

    function requireNode(query) {
        var normalized = normalizeNodeQuery(query);
        var node = findNode(query);
        if (node) return node;
        var nearby = nearbyNodes(normalized, 5);
        var descriptions = [];
        for (var i = 0; i < nearby.length; i++) descriptions.push(formatNode(nearby[i]));
        throw new Error("DSS.nodes.require: " + normalized.by + " '" + normalized.value +
                        "' not found among " + Scene.getNumNodes() + " scene nodes" +
                        (descriptions.length ? ". Nearby: " + descriptions.join("; ") : ""));
    }

    function renderContext() {
        var manager = App.getRenderMgr();
        if (!manager) throw new Error("DSS.render: render manager unavailable");
        var options = manager.getRenderOptions();
        if (!options) throw new Error("DSS.render: render options unavailable");
        return { manager: manager, options: options };
    }

    function readRenderState() {
        var context = renderContext();
        var options = context.options;
        var size = options.imageSize;
        var viewport = null;
        try { viewport = !!options.renderViewport; } catch (e) {}
        var camera = null;
        try { camera = options.camera ? describeNode(options.camera) : null; } catch (e2) {}
        return {
            outputPath: String(options.renderImgFilename || ""),
            width: Number(size.width),
            height: Number(size.height),
            renderImgToId: Number(options.renderImgToId),
            renderType: Number(options.renderType),
            directToFile: Number(options.renderImgToId) === Number(options.DirectToFile),
            software: Number(options.renderType) === Number(options.Software),
            renderViewport: viewport,
            camera: camera,
            activeRendererClass: context.manager.getActiveRenderer() ?
                String(context.manager.getActiveRenderer().className()) : null
        };
    }

    function configureRender(spec) {
        spec = spec || {};
        var context = renderContext();
        var options = context.options;
        if (spec.outputPath !== undefined && spec.outputPath !== null) {
            options.renderImgFilename = String(spec.outputPath);
        }
        if ((spec.width === undefined) !== (spec.height === undefined)) {
            throw new Error("DSS.render.configure: width and height must be supplied together");
        }
        if (spec.width !== undefined) {
            var width = Number(spec.width), height = Number(spec.height);
            if (!(width > 0) || !(height > 0)) {
                throw new Error("DSS.render.configure: width and height must be positive");
            }
            options.imageSize = new QSize(width, height);
        }
        if (spec.directToFile === true) options.renderImgToId = options.DirectToFile;
        if (spec.software === true) options.renderType = options.Software;
        if (spec.renderViewport !== undefined && spec.renderViewport !== null) {
            try { options.renderViewport = !!spec.renderViewport; }
            catch (viewportError) {
                throw new Error("DSS.render.configure: renderViewport unsupported: " + viewportError);
            }
        }
        if (spec.camera !== undefined && spec.camera !== null) options.camera = spec.camera;
        options.applyChanges();

        var actual = readRenderState();
        if (spec.outputPath !== undefined && spec.outputPath !== null &&
            actual.outputPath !== String(spec.outputPath)) {
            throw new Error("DSS.render.configure: output path failed readback");
        }
        if (spec.width !== undefined &&
            (actual.width !== Number(spec.width) || actual.height !== Number(spec.height))) {
            throw new Error("DSS.render.configure: image size failed readback");
        }
        if (spec.directToFile === true && !actual.directToFile) {
            throw new Error("DSS.render.configure: direct-to-file failed readback");
        }
        if (spec.software === true && !actual.software) {
            throw new Error("DSS.render.configure: software mode failed readback");
        }
        if (spec.renderViewport !== undefined && spec.renderViewport !== null &&
            actual.renderViewport !== !!spec.renderViewport) {
            throw new Error("DSS.render.configure: renderViewport failed readback");
        }
        if (spec.camera !== undefined && spec.camera !== null) {
            var wantedCamera = describeNode(spec.camera);
            if (!actual.camera || actual.camera.path !== wantedCamera.path ||
                actual.camera.name !== wantedCamera.name) {
                throw new Error("DSS.render.configure: camera failed readback");
            }
        }
        return actual;
    }

    function irayProperty(holder, name) {
        if (!holder || typeof holder.getNumProperties !== "function") return null;
        for (var i = 0; i < holder.getNumProperties(); i++) {
            var property = holder.getProperty(i);
            if (!property) continue;
            var propertyName = property.getName ? String(property.getName()) : String(property.name);
            var propertyLabel = property.getLabel ? String(property.getLabel()) : "";
            if (propertyName === name || propertyLabel === name) return property;
        }
        return null;
    }

    function setIrayCaps(spec) {
        spec = spec || {};
        var context = renderContext();
        var renderer = context.manager.getActiveRenderer();
        if (!renderer || typeof renderer.getPropertyHolder !== "function") {
            throw new Error("DSS.render.setIrayCaps: active renderer has no property holder");
        }
        var holder = renderer.getPropertyHolder();
        var samples = irayProperty(holder, "Max Samples");
        var time = irayProperty(holder, "Max Time");
        if (spec.maxSamples !== undefined && spec.maxSamples !== null) {
            if (!samples) throw new Error("DSS.render.setIrayCaps: Max Samples unavailable");
            samples.setValue(Number(spec.maxSamples));
        }
        if (spec.maxTime !== undefined && spec.maxTime !== null) {
            if (!time) throw new Error("DSS.render.setIrayCaps: Max Time unavailable");
            time.setValue(Number(spec.maxTime));
        }
        var actual = {
            maxSamples: samples ? Number(samples.getValue()) : null,
            maxTime: time ? Number(time.getValue()) : null
        };
        if (spec.maxSamples !== undefined && spec.maxSamples !== null &&
            actual.maxSamples !== Number(spec.maxSamples)) {
            throw new Error("DSS.render.setIrayCaps: Max Samples failed readback");
        }
        if (spec.maxTime !== undefined && spec.maxTime !== null &&
            actual.maxTime !== Number(spec.maxTime)) {
            throw new Error("DSS.render.setIrayCaps: Max Time failed readback");
        }
        return actual;
    }

    function normalizedPath(path) {
        var value = String(path || "").replace(/\\/g, "/");
        while (value.indexOf("//") >= 0) value = value.replace(/\/\//g, "/");
        if (/^[A-Za-z]:\//.test(value)) value = value.toLowerCase();
        return value;
    }

    function sceneIdentity() {
        var filename = String(Scene.getFilename() || "");
        return {
            filename: filename,
            normalizedFilename: normalizedPath(filename),
            fileExists: filename ? (new DzFileInfo(filename)).exists() : false,
            nodeCount: Scene.getNumNodes(),
            needsSave: !!Scene.needsSave()
        };
    }

    function requireSceneIdentity(spec) {
        spec = spec || {};
        var identity = sceneIdentity();
        if (spec.path !== undefined && spec.path !== null &&
            identity.normalizedFilename !== normalizedPath(spec.path)) {
            throw new Error("DSS.scene.require: expected file '" + String(spec.path) +
                            "' but Studio reports '" + identity.filename + "'");
        }
        if (spec.minNodes !== undefined && spec.minNodes !== null &&
            identity.nodeCount < Number(spec.minNodes)) {
            throw new Error("DSS.scene.require: expected at least " + Number(spec.minNodes) +
                            " nodes but found " + identity.nodeCount +
                            (identity.filename ? " in '" + identity.filename + "'" : ""));
        }
        return identity;
    }

    function loadScene(path, spec) {
        path = String(path || "");
        spec = spec || {};
        if (!path) throw new Error("DSS.scene.load: path is required");
        if (!spec.hasOwnProperty("replace")) {
            throw new Error("DSS.scene.load: replace must be explicitly true or false");
        }
        if (!(new DzFileInfo(path)).exists()) {
            throw new Error("DSS.scene.load: file not found: " + path);
        }
        if (spec.replace) Scene.clear();
        Scene.loadScene(path, new DzFileIOSettings());
        var required = {};
        if (spec.replace && spec.verifyFilename !== false) required.path = path;
        if (spec.minNodes !== undefined && spec.minNodes !== null) {
            required.minNodes = Number(spec.minNodes);
        }
        return requireSceneIdentity(required);
    }

    function reportPath() {
        try {
            if (typeof getArguments !== "function") return "";
            var args = getArguments();
            if (!args || !args.length || !args[0] || typeof args[0] !== "object") {
                return "";
            }
            return args[0].__dssReportFile ? String(args[0].__dssReportFile) : "";
        } catch (e) {
            return "";
        }
    }

    function appendReport(path, text) {
        var previous = "";
        try {
            var info = new DzFileInfo(path);
            if (info.exists()) {
                var reader = new DzFile(path);
                if (reader.open(DzFile.ReadOnly)) {
                    previous = String(reader.read());
                    reader.close();
                }
            }
            var writer = new DzFile(path);
            if (!writer.open(DzFile.WriteOnly)) return false;
            writer.write(previous + text);
            writer.close();
            return true;
        } catch (e) {
            // Observation must never be able to break the job it observes.
            return false;
        }
    }

    function emitReport(event, explicitPath) {
        var path = explicitPath ? String(explicitPath) : reportPath();
        if (!path) return false;
        try {
            return appendReport(path, JSON.stringify(event) + "\n");
        } catch (e) {
            return false;
        }
    }

    function progressReport(current, total, phase, message, explicitPath) {
        var event = { type: "progress", current: current, total: total };
        if (phase) event.phase = String(phase);
        if (message) event.message = String(message);
        return emitReport(event, explicitPath);
    }

    function logReport(message, level, source, explicitPath) {
        var event = {
            type: "log",
            level: level ? String(level) : "info",
            message: String(message)
        };
        if (source) event.source = String(source);
        return emitReport(event, explicitPath);
    }

    function outputReport(path, kind, label, metadata, explicitPath) {
        var event = { type: "output", path: String(path) };
        if (kind) event.kind = String(kind);
        if (label) event.label = String(label);
        if (metadata) event.metadata = metadata;
        return emitReport(event, explicitPath);
    }

    return {
        version: 1,
        nodes: {
            describe: describeNode,
            inspect: inspectNodes,
            find: findNode,
            require: requireNode
        },
        render: {
            read: readRenderState,
            configure: configureRender,
            setIrayCaps: setIrayCaps
        },
        scene: {
            identity: sceneIdentity,
            require: requireSceneIdentity,
            load: loadScene
        },
        visibility: { read: readVisibility, set: setVisibility },
        report: {
            path: reportPath,
            emit: emitReport,
            progress: progressReport,
            log: logReport,
            output: outputReport
        }
    };
})();
